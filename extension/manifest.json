{
  "manifest_version": 3,
  "name": "یه‌قدم — یه قدم اون‌ورتر، ارزون‌تر",
  "short_name": "یه‌قدم",
  "version": "0.0.0",
  "description": "چند قدم اون‌ورتر از مبدا یا مقصدت رو پیدا می‌کنه که اسنپ (ماشین یا موتور) ارزون‌تر حساب می‌کنه. فقط قیمت می‌پرسه و هیچ سفری ثبت نمی‌کنه. غیررسمی.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.snapp.taxi/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yeghadam@yeghadam.app",
      "strict_min_version": "128.0"
    }
  }
}
